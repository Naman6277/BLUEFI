<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Public external shared storage paths for Download, Movies, Pictures, Music -->
    <external-path
        name="external_storage_root"
        path="." />

    <!-- App-specific external storage paths -->
    <external-files-path
        name="external_downloads"
        path="Download" />
    <external-files-path
        name="external_movies"
        path="Movies" />
    <external-files-path
        name="external_pictures"
        path="Pictures" />
    <external-files-path
        name="external_music"
        path="Music" />
    <external-files-path
        name="external_files"
        path="." />

    <!-- Cache and internal storage paths -->
    <external-cache-path
        name="external_cache"
        path="." />
    <cache-path
        name="internal_cache"
        path="." />
    <files-path
        name="internal_files"
        path="." />
    <files-path
        name="secure_videos"
        path="secure_videos" />
</paths>
