<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <androidx.cardview.widget.CardView
        android:layout_width="260dp"
        android:layout_height="180dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_container">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Video Thumbnail Preview -->
            <ImageView
                android:id="@+id/imgVideoThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Video Preview" />

            <!-- Dark Translucent Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#44000000" />

            <!-- Center Play Button Icon -->
            <ImageView
                android:id="@+id/imgPlayIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/text_primary"
                android:contentDescription="Play Video" />

            <!-- Video Duration Badge -->
            <TextView
                android:id="@+id/tvVideoDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="@drawable/avatar_circle_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="0:12"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <!-- Dedicated Save/Download Button in Bottom-Right Corner -->
            <ImageButton
                android:id="@+id/btnSaveToStorage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/avatar_circle_bg"
                android:src="@drawable/ic_download"
                app:tint="@color/fast_electric_blue"
                android:contentDescription="Save to Phone Storage" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
