<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <androidx.cardview.widget.CardView
        android:layout_width="240dp"
        android:layout_height="220dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_container">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgImagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Image Preview" />

            <!-- Dedicated Save/Download Button in Bottom-Right Corner -->
            <ImageButton
                android:id="@+id/btnSaveImageToStorage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/avatar_circle_bg"
                android:src="@drawable/ic_download"
                app:tint="@color/fast_electric_blue"
                android:contentDescription="Save Image to Gallery" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
